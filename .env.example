# Database
# LOCAL DEVELOPMENT: a SQLite file is fine.
DATABASE_URL=file:./salon.db
SALON_DB_PATH=./salon.db
#
# PRODUCTION / VERCEL: a local file CANNOT work — the bundle directory is
# read-only and every serverless instance gets its own temporary filesystem, so
# the catalogue would be unreadable or vanish between requests. Set a hosted
# libSQL/Turso database instead:
#
#   DATABASE_URL=libsql://your-database.turso.io
#   DATABASE_AUTH_TOKEN=replace-with-the-database-token
#
# The Turso CLI and Vercel's Turso integration use different names for the same
# values. Either pair is accepted, and DATABASE_URL wins when both are present:
#
#   TURSO_DATABASE_URL=libsql://your-database.turso.io
#   TURSO_AUTH_TOKEN=replace-with-the-database-token
#
# LIBSQL_URL is also accepted as an alias for the URL only.

# Owner access
AUTH_SECRET=716b6231d609a6608d67b5725255323956c3c4e340798758d1c3c5039b13d17c
# Set this instead of database password setup if desired.
# OWNER_PASSWORD=replace-with-owner-password
# Required for one-time database password setup at /owner/login.
OWNER_SETUP_TOKEN=30570792fc5d06b5e5b55a606d4e5e6fe5fc715c62152a669829dfceaebd31b2

# Salon configuration

# Optional: build output directory. Leave unset for the default `.next`.
# Set it to `.build` on a OneDrive-synced checkout, where Turbopack's cleanup of
# the dependency junctions under `.next/node_modules` can fail with EPERM.
# NEXT_DIST_DIR=.build

# Configure the real owner WhatsApp recipient in production only.
WHATSAPP_OWNER_RECIPIENT=
# Development recipient is used only outside production. Never use the live owner number here.
WHATSAPP_DEV_RECIPIENT=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_NEW_REQUEST=
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_REJECTED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=


